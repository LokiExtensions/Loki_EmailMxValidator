{
    "name": "loki/magento2-email-mx-validator",
    "version": "1.0.5",
    "description": "Add-on to Loki Components to allow the MX record of an email to be validated",
    "type": "magento2-module",
    "keywords": [
        "loki-components"
    ],
    "require": {
        "loki/magento2-components": "^2.0",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "magento/module-store": "^101.1",
        "php": ">=8.2 <8.6",
        "spatie/dns": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yireo/magento2-integration-test-helper": "~0.0",
        "loki/magento2-functional-tests": "@dev"
    },
    "license": [
        "OSL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Loki\\EmailMxValidator\\": ""
        }
    }
}